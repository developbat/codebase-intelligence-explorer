{
  "name": "codebase-intelligence-explorer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Read-only code intelligence explorer: static analysis, knowledge graph, Git change impact, and optional multi-provider AI analysis.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx server/src/index.ts --serve-web",
    "analyze": "tsx server/src/cli.ts",
    "test": "tsx --test --test-concurrency=1 server/src/*.test.ts",
    "eval:stages": "tsx server/src/evalStages.ts",
    "eval:ask": "tsx server/src/evalAsk.ts",
    "eval:change": "tsx server/src/evalChange.ts",
    "eval:extract": "tsx server/src/evalExtraction.ts",
    "eval:tools": "tsx server/src/evalToolUse.ts",
    "eval:templates": "tsx server/src/templateE2E.ts",
    "eval:verify": "tsx server/src/evalVerify.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/php": "^1.0.6",
    "@lezer/python": "^1.1.19",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.3.6",
    "chokidar": "^3.6.0",
    "diff": "^5.2.2",
    "driver.js": "^1.10.2",
    "elkjs": "^0.9.3",
    "express": "^4.21.2",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "postprocessing": "^6.36.4",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.170.0",
    "typescript": "^5.7.2",
    "typescript-language-server": "^6.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "vite": "^5.4.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developbat/codebase-intelligence-explorer.git"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "typescript",
    "static-analysis",
    "git",
    "ai",
    "react",
    "threejs"
  ]
}
